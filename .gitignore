# ==============================================================================
# SALBAR Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Keys
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
secrets/

# ------------------------------------------------------------------------------
# Node.js / Web Dashboard / JavaScript / TypeScript
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python / Backend Services / Machine Learning
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter / ML Checkpoints
.ipynb_checkpoints/
*.pt
*.pth
*.onnx
*.bin
*.safetensors
models/checkpoints/
models/weights/
wandb/

# ------------------------------------------------------------------------------
# Embedded / Firmware (PlatformIO / Arduino / ESP-IDF)
# ------------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clangd/
compile_commands.json
*.hex
*.bin
*.elf
*.o
*.a
firmware/**/build/

# ------------------------------------------------------------------------------
# Android / Mobile Application (Gradle & Kotlin)
# ------------------------------------------------------------------------------
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/
output.json

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/

# ------------------------------------------------------------------------------
# Thesis Documentation
# ------------------------------------------------------------------------------
docs/
